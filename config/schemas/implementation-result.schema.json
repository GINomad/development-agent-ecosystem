{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "branch", "headCommit", "changedFiles", "implementedRequirementIds", "heldRequirementIds", "scenarioResults", "tests", "newQuestions", "summary"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "headCommit": { "type": ["string", "null"] },
    "changedFiles": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "implementedRequirementIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "heldRequirementIds": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "scenarioResults": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenarioResult" } },
    "tests": { "type": "array", "items": { "$ref": "#/$defs/test" } },
    "newQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "scenarioResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenarioId", "status", "evidence", "commit"],
      "properties": {
        "scenarioId": { "type": "string", "pattern": "^SCN-[A-Za-z0-9._-]+$" },
        "status": { "enum": ["passed", "failed", "blocked"] },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result", "evidence"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "result": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "publicationEvidenceId": { "type": "string", "minLength": 1 }
      }
    }
  }
}
