{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "reviewedRevision", "requirementsRevision", "requirementTraceability", "findings", "heldScopeViolations", "agentProcessFindings", "summary"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "reviewedRevision": { "type": "string", "minLength": 1 },
    "requirementsRevision": { "type": "string", "minLength": 1 },
    "requirementTraceability": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirementTrace" }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "heldScopeViolations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "agentProcessFindings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "location", "evidence", "impact", "correctionDirection", "decisionStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^REV-[0-9]{3,}$" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "category": { "enum": ["correctness", "security", "regression", "testing", "maintainability", "requirements", "knowledge", "agent-process"] },
        "location": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "correctionDirection": { "type": "string", "minLength": 1 },
        "decisionStatus": { "const": "proposed" },
        "codeLocation": { "$ref": "#/$defs/codeLocation" }
      }
    },
    "codeLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "filePath"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "oldLine": { "type": "integer", "minimum": 1 },
        "newLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["oldLine"] },
        { "required": ["newLine"] }
      ]
    },
    "codeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "filePath", "startLine", "evidence"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "requirementTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "requirementText", "implementationStatus", "codeReferences", "testEvidence", "notes"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "requirementText": { "type": "string", "minLength": 1 },
        "implementationStatus": { "enum": ["verified", "partially-verified", "not-verified", "held", "not-applicable"] },
        "codeReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeReference" }
        },
        "testEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
