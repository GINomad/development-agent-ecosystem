{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review result",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "reviewedRevision", "requirementsRevision", "requirementTraceability", "reviewCoverage", "findings", "heldScopeViolations", "agentProcessFindings", "findingLifecycle", "summary"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "reviewedRevision": { "type": "string", "minLength": 1 },
    "requirementsRevision": { "type": "string", "minLength": 1 },
    "requirementTraceability": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirementTrace" }
    },
    "reviewCoverage": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": { "$ref": "#/$defs/reviewCoverageEntry" }
    },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "heldScopeViolations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "agentProcessFindings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "findingLifecycle": { "type": "array", "items": { "$ref": "#/$defs/findingLifecycle" } },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "reviewDimension": {
      "enum": ["requirements", "correctness", "security", "regression", "testing", "maintainability", "performance", "concurrency", "configuration-deployment", "documentation"]
    },
    "reviewCoverageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "status", "evidence", "notes"],
      "properties": {
        "dimension": { "$ref": "#/$defs/reviewDimension" },
        "status": { "enum": ["covered", "not-applicable", "blocked"] },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "category", "location", "evidence", "impact", "correctionDirection", "decisionStatus"],
      "properties": {
        "id": { "type": "string", "pattern": "^REV-[0-9]{3,}$" },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "category": { "enum": ["correctness", "security", "regression", "testing", "maintainability", "performance", "concurrency", "configuration-deployment", "documentation", "requirements", "knowledge", "agent-process"] },
        "location": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "correctionDirection": { "type": "string", "minLength": 1 },
        "decisionStatus": { "const": "proposed" },
        "codeLocation": { "$ref": "#/$defs/codeLocation" }
      }
    },
    "findingLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "status", "firstSeenRevision", "lastObservedRevision", "evidence"],
      "properties": {
        "findingId": { "type": "string", "pattern": "^REV-[0-9]{3,}$" },
        "status": { "enum": ["new", "unchanged", "resolved", "regressed"] },
        "firstSeenRevision": { "type": "string", "minLength": 1 },
        "lastObservedRevision": { "type": "string", "minLength": 1 },
        "resolvedRevision": { "type": "string", "minLength": 1 },
        "previousResolutionRevision": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "resolved" } }, "required": ["status"] },
          "then": { "required": ["resolvedRevision"] }
        },
        {
          "if": { "properties": { "status": { "const": "regressed" } }, "required": ["status"] },
          "then": { "required": ["previousResolutionRevision"] }
        }
      ]
    },
    "codeLocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "filePath"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "oldLine": { "type": "integer", "minimum": 1 },
        "newLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 }
      },
      "anyOf": [
        { "required": ["oldLine"] },
        { "required": ["newLine"] }
      ]
    },
    "codeReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repositoryId", "filePath", "startLine", "evidence"],
      "properties": {
        "repositoryId": { "type": "string", "minLength": 1 },
        "filePath": { "type": "string", "minLength": 1 },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "symbol": { "type": "string", "minLength": 1 },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "requirementTrace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementId", "requirementText", "implementationStatus", "codeReferences", "testEvidence", "notes"],
      "properties": {
        "requirementId": { "type": "string", "minLength": 1 },
        "requirementText": { "type": "string", "minLength": 1 },
        "implementationStatus": { "enum": ["verified", "partially-verified", "not-verified", "held", "not-applicable"] },
        "codeReferences": {
          "type": "array",
          "items": { "$ref": "#/$defs/codeReference" }
        },
        "testEvidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
