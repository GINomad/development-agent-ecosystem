{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-backed knowledge update",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "entries", "humanReadable"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "statement", "source", "revision", "observedAtUtc", "observedBy", "targetPath"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["verified", "proposed", "superseded"] },
          "statement": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "revision": { "type": "string", "minLength": 1 },
          "observedAtUtc": { "type": "string", "format": "date-time" },
          "observedBy": { "type": "string", "minLength": 1 },
          "targetPath": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["fact", "decision", "code-standard", "review-lesson"] },
          "scope": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "supersedes": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "humanReadable": { "$ref": "#/$defs/humanReadable" }
  },
  "$defs": {
    "humanReadable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "overview", "audience", "updates"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "overview": { "type": "string", "minLength": 1 },
        "audience": { "type": "string", "minLength": 1 },
        "updates": {
          "type": "array",
          "items": { "$ref": "#/$defs/documentationUpdate" }
        }
      }
    },
    "documentationUpdate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledgeId", "title", "description", "applicability", "status"],
      "properties": {
        "knowledgeId": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "minLength": 1 },
        "status": { "enum": ["verified", "superseded"] }
      }
    }
  }
}

