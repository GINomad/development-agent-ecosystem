{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "status", "completedAtUtc", "repositories", "outcomes", "decisions", "verification", "knowledgeUpdates", "artifacts", "residualItems"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "status": { "const": "completed" },
    "completedAtUtc": { "type": "string", "format": "date-time" },
    "repositories": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "outcomes": { "type": "array", "items": { "type": "object", "required": ["agentId", "summary"], "properties": { "agentId": { "type": "string" }, "summary": { "type": "string" }, "artifact": { "type": ["string", "null"] } } } },
    "decisions": { "type": "array", "items": { "type": "string" } },
    "verification": { "type": "array", "items": { "type": "string" } },
    "knowledgeUpdates": { "type": "array", "items": { "type": "string" } },
    "artifacts": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "residualItems": { "type": "array", "items": { "type": "string" } }
  }
}
