{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Implementation plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "branch", "baseBranch", "steps", "heldScope", "requirementsRevision", "knowledgeRevision"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "heldScope": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "requirementsRevision": { "type": "string", "minLength": 1 },
    "knowledgeRevision": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirementIds", "files", "change", "validation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "files": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "change": { "type": "string", "minLength": 1 },
        "validation": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}

