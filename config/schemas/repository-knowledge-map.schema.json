{
  "title": "Repository knowledge map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatorVersion", "repositoryId", "revision", "sourceFingerprint", "generatedAtUtc", "summary", "audit", "components", "entryPoints", "nodes", "edges", "lookupHints", "recommendedStart"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "generatorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "repositoryId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "revision": { "type": "string", "minLength": 1 },
    "sourceFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "directoryCount", "componentCount", "edgeCount"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 0 },
        "directoryCount": { "type": "integer", "minimum": 0 },
        "componentCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structuralStatus", "semanticStatus", "instructions"],
      "properties": {
        "structuralStatus": { "const": "indexed" },
        "semanticStatus": { "enum": ["pending", "verified"] },
        "instructions": { "type": "string", "minLength": 1 }
      }
    },
    "components": { "type": "array", "items": { "$ref": "#/$defs/component" } },
    "entryPoints": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "lookupHints": { "type": "object", "additionalProperties": { "type": "array", "items": { "type": "string", "minLength": 1 }, "maxItems": 12 } },
    "recommendedStart": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true, "maxItems": 30 }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "kind", "manifest", "projectReferences", "packageDependencies"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "manifest": { "type": "string", "minLength": 1 },
        "projectReferences": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "packageDependencies": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "path", "purpose"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["repository", "directory", "file"] },
        "path": { "type": "string" },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "kind"],
      "properties": {
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["contains", "references"] }
      }
    }
  }
}
