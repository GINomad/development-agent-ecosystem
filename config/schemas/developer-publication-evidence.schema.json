{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Developer publication evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "generatedAtUtc", "workspace", "branch", "upstream", "headCommit", "worktreeClean", "branchDivergence", "pester"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "workspace": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "upstream": { "type": "string", "minLength": 1 },
    "headCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "worktreeClean": { "type": "boolean" },
    "branchDivergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceId", "command", "behindCount", "aheadCount", "rawResult"],
      "properties": {
        "evidenceId": { "const": "git-branch-divergence" },
        "command": { "type": "string", "minLength": 1 },
        "behindCount": { "type": "integer", "minimum": 0 },
        "aheadCount": { "type": "integer", "minimum": 0 },
        "rawResult": { "type": "string", "minLength": 1 }
      }
    },
    "pester": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "path", "command", "passedCount", "failedCount", "skippedCount", "totalCount", "result"],
        "properties": {
          "evidenceId": { "type": "string", "pattern": "^pester-[1-9][0-9]*$" },
          "path": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "passedCount": { "type": "integer", "minimum": 0 },
          "failedCount": { "type": "integer", "minimum": 0 },
          "skippedCount": { "type": "integer", "minimum": 0 },
          "totalCount": { "type": "integer", "minimum": 0 },
          "result": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
