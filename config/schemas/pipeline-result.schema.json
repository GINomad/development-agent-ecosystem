{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pipeline monitoring result",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "branch", "commit", "runs", "overallResult", "summary"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
    "overallResult": { "enum": ["succeeded", "non-success", "no-run"] },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "sourceVersion", "result", "failedLogExcerpts"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "url": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "result": { "enum": ["succeeded", "failed", "partiallySucceeded", "canceled", "timedOut"] },
        "failedLogExcerpts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

