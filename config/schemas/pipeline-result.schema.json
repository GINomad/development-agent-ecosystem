{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Post-push pipeline monitoring result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "repositoryId",
    "observedAtUtc",
    "branch",
    "commit",
    "queuedDefinitionIds",
    "runs",
    "overallResult",
    "failureClassification",
    "remediation",
    "summary"
  ],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "repositoryId": { "type": "string", "minLength": 1 },
    "observedAtUtc": { "type": "string", "format": "date-time" },
    "branch": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
    "queuedDefinitionIds": { "type": "array", "uniqueItems": true, "items": { "type": "integer", "minimum": 1 } },
    "runs": { "type": "array", "items": { "$ref": "#/$defs/run" } },
    "overallResult": { "enum": ["succeeded", "non-success", "no-run"] },
    "failureClassification": { "$ref": "#/$defs/classification" },
    "queueFailure": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/queueFailure" }
      ]
    },
    "humanIntervention": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/humanIntervention" }
      ]
    },
    "remediation": { "$ref": "#/$defs/remediation" },
    "summary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "resolutionOption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "action": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "humanIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason", "options", "recommendedOptionId", "recommendationRationale"],
      "properties": {
        "required": { "const": true },
        "reason": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resolutionOption" } },
        "recommendedOptionId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "recommendationRationale": { "type": "string", "minLength": 1 }
      }
    },
    "queueFailure": {
      "type": "object",
      "additionalProperties": true,
      "required": ["diagnosticType", "definitionId", "category", "developerEligible", "matchedSignals", "summary", "queueError", "resourceChecks", "humanIntervention"],
      "properties": {
        "diagnosticType": { "const": "queue-validation" },
        "definitionId": { "type": "integer", "minimum": 1 },
        "category": { "enum": ["code", "infrastructure"] },
        "developerEligible": { "type": "boolean" },
        "matchedSignals": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string", "minLength": 1 },
        "queueError": { "type": "string", "minLength": 1 },
        "resourceChecks": { "type": "array" },
        "humanIntervention": { "$ref": "#/$defs/humanIntervention" }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "developerEligible", "matchedSignals"],
      "properties": {
        "category": { "enum": ["none", "code", "test", "infrastructure", "unknown"] },
        "developerEligible": { "type": "boolean" },
        "matchedSignals": { "type": "array", "maxItems": 8, "items": { "type": "string" } }
      }
    },
    "remediation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "cycle", "maxCycles", "failureSignature", "targetAgentId", "reason"],
      "properties": {
        "status": { "enum": ["not-applicable", "pending", "limit-reached"] },
        "cycle": { "type": "integer", "minimum": 0, "maximum": 3 },
        "maxCycles": { "type": "integer", "minimum": 1, "maximum": 3 },
        "failureSignature": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
        "targetAgentId": { "type": ["string", "null"], "enum": ["developer", null] },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "failedTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "category", "logExcerpt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "category": { "enum": ["code", "test", "infrastructure", "unknown"] },
        "logExcerpt": { "type": "string" }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "definitionId", "definitionName", "url", "sourceVersion", "result", "failedTasks", "failedLogExcerpts"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "definitionId": { "type": "integer", "minimum": 1 },
        "definitionName": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "minLength": 1 },
        "sourceVersion": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "result": { "enum": ["succeeded", "failed", "partiallySucceeded", "canceled", "timedOut"] },
        "failedTasks": { "type": "array", "items": { "$ref": "#/$defs/failedTask" } },
        "failedLogExcerpts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
