{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human review decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "decisions"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["findingId", "reviewedRevision", "reviewArtifactSha256", "verificationVerdict", "decision", "decidedAtUtc", "decidedBy", "note"],
        "properties": {
          "findingId": { "type": "string", "pattern": "^REV-[0-9]{3,}$" },
          "reviewedRevision": { "type": "string", "minLength": 1 },
          "reviewArtifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "verificationVerdict": { "enum": ["confirmed", "needs-human"] },
          "decision": { "enum": ["approved", "rejected", "deferred", "bypassed"] },
          "decidedAtUtc": { "type": "string", "format": "date-time" },
          "decidedBy": { "type": "string", "minLength": 1 },
          "note": { "type": "string" },
          "techDebtItemId": { "type": "string", "pattern": "^TD-REV-[0-9]{3,}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "decision": { "const": "bypassed" } }, "required": ["decision"] },
            "then": { "required": ["techDebtItemId"], "properties": { "note": { "minLength": 1 } } }
          }
        ]
      }
    }
  }
}
