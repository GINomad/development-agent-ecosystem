{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent context pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["taskId", "recipient", "createdAtUtc", "sources", "acceptedKnowledge", "artifactSummaries", "engineeringGuidance", "openQuestions", "heldScope"],
  "properties": {
    "taskId": { "type": "string", "minLength": 1 },
    "recipient": { "type": "string", "minLength": 1 },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "acceptedKnowledge": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "artifactSummaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "summary", "updatedAtUtc"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "summary": { "type": "string", "minLength": 1 },
          "updatedAtUtc": { "type": "string", "format": "date-time" }
        }
      }
    },
    "engineeringGuidance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detectedStack", "selectedSkills", "reason"],
      "properties": {
        "detectedStack": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "selectedSkills": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "openQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "heldScope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "location", "revision", "reason"],
      "properties": {
        "kind": { "enum": ["task", "comment", "code", "test", "knowledge", "review", "pipeline", "history"] },
        "location": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
