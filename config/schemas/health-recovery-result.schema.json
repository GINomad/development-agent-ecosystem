{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automatic agent health recovery result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "failureSignature", "rootCause", "repairOwner", "routeAgentId", "requiresUserInput", "changes", "validation", "nextAction"],
  "properties": {
    "status": { "enum": ["repaired", "not-repairable", "needs-user-input", "blocked"] },
    "failureSignature": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rootCause": { "type": "string", "minLength": 1 },
    "repairOwner": {
      "enum": ["ecosystem_recovery", "orchestrator", "knowledge_keeper", "requirements_analyst", "developer", "reviewer", "pipeline_monitor", "human"]
    },
    "routeAgentId": {
      "type": ["string", "null"],
      "enum": [null, "orchestrator", "knowledge_keeper", "requirements_analyst", "developer", "reviewer", "pipeline_monitor"]
    },
    "requiresUserInput": { "type": "boolean" },
    "changes": { "type": "array", "items": { "type": "string" } },
    "validation": { "type": "array", "items": { "type": "string" } },
    "nextAction": { "type": "string", "minLength": 1 },
    "humanIntervention": { "$ref": "#/$defs/humanIntervention" }
  },
  "$defs": {
    "humanIntervention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "reason", "options", "recommendedOption", "recommendationRationale"],
      "properties": {
        "request": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "recommendedOption": { "type": "string", "minLength": 1 },
        "recommendationRationale": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "requiresUserInput": { "const": true } },
        "required": ["requiresUserInput"]
      },
      "then": { "required": ["humanIntervention"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "needs-user-input" } },
        "required": ["status"]
      },
      "then": {
        "required": ["humanIntervention"],
        "properties": { "requiresUserInput": { "const": true } }
      }
    }
  ]
}
